# Copy to .env (gitignored) and fill in. All fields are optional —
# the frontend Settings dialog can supply provider/model/key per request.

# Default provider when the frontend doesn't override.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# Provider API keys. Add only the one(s) you want available as the
# server-side fallback.
GEMINI_API_KEY=
OPENAI_API_KEY=
